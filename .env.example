# =============================================================================
# SSIMS environment template
#
# Copy to .env and fill EVERY blank value, or use the generator:
#   ./scripts/generate-env.sh
#   powershell -ExecutionPolicy Bypass -File scripts/generate-env.ps1
#
# Never commit .env. Generate secrets with: openssl rand -hex 32
# Compose uses ${VAR:?} checks and will refuse to start with blank secrets.
# =============================================================================

NODE_ENV=development
# Local Vite development origin. Docker uses PUBLIC_ORIGIN.
FRONTEND_ORIGIN=http://localhost:5173
# Comma-separated additional trusted browser origins (e.g. https://127.0.0.1)
ADDITIONAL_ORIGINS=
PUBLIC_ORIGIN=https://localhost
API_PORT=4000
LOG_LEVEL=info

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=ssims
POSTGRES_USER=postgres
POSTGRES_SUPERUSER_PASSWORD=
POSTGRES_OWNER=ssims_owner
POSTGRES_OWNER_PASSWORD=
POSTGRES_APP_USER=ssims_app
POSTGRES_APP_PASSWORD=
POSTGRES_RO_PASSWORD=

# Local development connections. Docker Compose constructs its own internal
# URLs from the POSTGRES_* values and never publishes the database.
DATABASE_ADMIN_URL=
DATABASE_URL=

# TLS settings for the application -> PostgreSQL connection.
# Local development without TLS: disable. Docker: verify-full.
DB_SSL_MODE=disable
DB_SSL_CA=
DB_SSL_SERVERNAME=localhost
# Managed PostgreSQL usually cannot CREATE ROLE. Set true for a single-role
# hosted database; keep false for local/Compose least-privilege deployments.
SKIP_ROLE_BOOTSTRAP=false

# --- Cryptographic secrets (min 32 chars, unique) ----------------------------
JWT_ACCESS_SECRET=
COOKIE_SECRET=
MFA_ENCRYPTION_KEY=
CHALLENGE_SECRET=
WEBHOOK_SECRET=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
TRUST_PROXY=0
EXPOSE_RESET_TOKEN=true

# Bootstrap passwords. Use long random values, never production defaults.
SEED_SUPER_ADMIN_EMAIL=superadmin@ssims.edu
SEED_SUPER_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=admin@ssims.edu
SEED_ADMIN_PASSWORD=
SEED_LECTURER_EMAIL=lecturer@ssims.edu
SEED_LECTURER_PASSWORD=
SEED_STUDENT_EMAIL=student@ssims.edu
SEED_STUDENT_PASSWORD=
SEED_LAB_EMAIL=security.lab@ssims.edu
SEED_LAB_PASSWORD=
